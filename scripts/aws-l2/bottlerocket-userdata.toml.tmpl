# Bottlerocket user-data (TOML) — minimal SSM-only smoke.
#
# Bottlerocket has a read-only rootfs and no shell on the host.
# Bring-up via a custom bootstrap-container (we built one in
# scripts/aws-l2/bottlerocket-bootstrap/) was attempted but the
# bootstrap-container facility has unresolved issues for our shape:
#   - bootstrap-container exits non-zero with no captured stdout
#     (image runs locally; on Bottlerocket no `entrypoint ran` log)
#   - host-containerd's image-pull auth differs from kubelet's; even
#     with a publicly-accessible ECR-Public image the container
#     fails before our entrypoint logs anything
#
# Until that's resolved, the Bottlerocket smoke validates only:
#   1. Bottlerocket AMI launches with our IAM role
#   2. SSM control container reaches Online
#   3. The L2 driver writes the sentinel via SSM
#
# Full Bottlerocket integration (cert-manager + SPIRE + operator
# + CRDs) is left as a follow-up — the right path is likely
# joining an existing EKS control plane rather than running k0s
# in a bootstrap-container.

[settings.host-containers.admin]
# Set true (and provide an SSH key via separate user-data, or use
# the SSM session-manager) to debug bootstrap failures via:
#   apiclient exec admin journalctl \
#     -D /.bottlerocket/rootfs/var/log/journal/ \
#     -u bootstrap-containers@<name>.service
# See scripts/aws-l2/bottlerocket-bootstrap/README.md.
enabled = false
