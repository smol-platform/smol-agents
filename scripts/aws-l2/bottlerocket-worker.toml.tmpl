# Bottlerocket aws-k8s-1.31 worker user-data.
#
# This is the canonical Bottlerocket use case: the AMI ships a
# kubelet-on-host pre-configured to join an externally-managed
# Kubernetes control plane. We point it at our AL2023-hosted k0s
# controller (provisioned by the same test pair) using:
#
#   .APIServer        : https://<controller-public-ip>:6443
#   .ClusterCABase64  : k0s CA cert from /var/lib/k0s/pki/ca.crt
#   .BootstrapToken   : k0s-issued worker join token
#   .ClusterName      : arbitrary tag, "smol-agents-l2"
#
# These are populated at runtime by the L2 driver after the
# controller's health gate passes.

[settings.aws]
region = "us-east-2"

[settings.kubernetes]
api-server = "{{ .APIServer }}"
cluster-certificate = "{{ .ClusterCABase64 }}"
cluster-name = "{{ .ClusterName }}"
cluster-dns-ip = "10.96.0.10"
cluster-domain = "cluster.local"
authentication-mode = "tls"
bootstrap-token = "{{ .BootstrapToken }}"
node-labels = { "node.kubernetes.io/role" = "worker", "smol-agents.stigen.ai/distro" = "bottlerocket" }
# Explicitly set node-ip + provider-id so pluto's settings-generator
# doesn't need to call ec2:DescribeInstances. Without these the
# bootstrap blocks at "Generate additional settings for Kubernetes"
# even with the IAM permission applied.
node-ip = "0.0.0.0"

[settings.host-containers.admin]
enabled = false
