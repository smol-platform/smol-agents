#cloud-config
#
# Flatcar Linux user-data — minimal-validation smoke.
#
# Flatcar's preferred bootstrap is Ignition (JSON, applied via the
# initramfs); cloud-init is NOT installed by default on the AWS AMI.
# A YAML cloud-config file like this one is silently dropped on the
# floor at boot. Validating cloud-init compat across Flatcar
# versions is brittle, so the L2 smoke for Flatcar instead checks:
#
#   1. Flatcar AMI launches and reaches network-Online
#   2. SSM agent (built-in to Flatcar via systemd) registers
#   3. The L2 driver writes the sentinel via SSM
#
# Full Flatcar bootstrap (k0s + manifests + ECR auth) belongs in
# an Ignition spec, not here. Tracked as a follow-up: emit Ignition
# JSON as a separate template + base64-encoded user-data.
#
# Template vars are NOT used.

# placeholder content kept so renderers detect the file as cloud-init
# even though Flatcar doesn't process it.
runcmd:
  - true
