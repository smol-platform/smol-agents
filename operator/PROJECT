domain: stigen.ai
layout:
  - go.kubebuilder.io/v4
projectName: knative-agents-operator
repo: github.com/stigen/knative-agents/operator
version: "3"
resources:
  - api:
      crdVersion: v1
      namespaced: true
    controller: true
    domain: stigen.ai
    group: agents
    kind: KnativeAgent
    path: github.com/stigen/knative-agents/operator/api/v1
    version: v1
  - api:
      crdVersion: v1
      namespaced: false
    controller: true
    domain: stigen.ai
    group: agents
    kind: KnativeAgentPlatform
    path: github.com/stigen/knative-agents/operator/api/v1
    version: v1
